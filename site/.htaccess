RewriteEngine On

# Legacy slugs: preserve equity with a single, explicit 301 hop.
RewriteRule ^osservicos/?$ https://betinhos.com.br/#solucoes [R=301,L,NE]
RewriteRule ^contato/?$ https://betinhos.com.br/#contato [R=301,L,NE]
RewriteRule ^tradicao/?$ https://betinhos.com.br/#empresa [R=301,L,NE]
RewriteRule ^missaovisaoevalores/?$ https://betinhos.com.br/#empresa [R=301,L,NE]

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^betinhos\.com\.br$ [NC]
RewriteRule ^ https://betinhos.com.br%{REQUEST_URI} [R=301,L]

AddType application/javascript .js
AddType image/webp .webp
AddType image/avif .avif
AddType font/woff2 .woff2
AddType font/ttf .ttf
AddType video/mp4 .mp4
AddType video/webm .webm

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "^(?:40-anos-.*|assinatura-email-40-anos|cta-options)\.html$">
    Header always set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
  <FilesMatch "\.(?:woff2|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:png|jpe?g|svg|webp|avif|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(?:html?)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
